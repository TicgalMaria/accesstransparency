{% import 'components/form/fields_macros.html.twig' as fields %}

{{ include('components/pager.html.twig', {
	href: href,
    count: total_number,
    additional_params: additional_params
}) }}

<div class="table-responsive">
	<input type="hidden" name="id" value="{{ userId }}"/>
	<table class="table table-hover">
		<thead>
			<tr>
				<th>{{ __('ID') }}</th>
				<th>{{ __('Date') }}</th>
				<th>{{ __('Itemtype') }}</th>
				<th>{{ __('Field') }}</th>
				<th>{{ __('Changes') }}</th>
				<th>
					<span class="float-end log-toolbar mb-0 d-flex align-items-center gap-1">
						{% set has_filters = filters.date is defined or filters.itemtype is defined or filters.field is defined %}
						<button type="button" 
								id="btn_show_filters" 
								class="btn btn-sm {{ has_filters ? 'btn-secondary active' : 'btn-outline-secondary' }}">
							<i class="ti ti-filter"></i>
							<span class="d-none d-xl-inline-block">{{ __('Filter') }}</span>
						</button>		
						<a href="{{ '/plugins/accesstransparency/front/export_user_csv.php?id=' ~ userId ~ '&' ~ additional_params }}" class="btn btn-sm btn-outline-secondary" target="_blank">
							<i class="fas fa-file-export"></i>
							<span class="d-none d-xl-inline-block" style="text-transform:none;">{{ __('Export') }}</span>
						</a>
					</span>
				</th>
			</tr>

			<tr class="filter_row {{ filters|length == 0 ? 'd-none' : '' }}" 
    			{% if filters|length == 0 %} style="display: none !important;" {% endif %}>
				<td>
					<input type="hidden" name="filters[active]" value="1" />
				</td>
				<td>
					{{ fields.dateField(
						'filters[date]',
						filters['date'],
						'',
						{
							no_label: true,
							full_width: true,
							mb: '',
						},
					) }}
				</td>
				<td>
					{{
						fields.dropdownArrayField(
							'filters[itemtype]',
							'',
							itemtypes,
							'',
							{
								no_label: true,
								full_width: true,
								multiple: true,
								values: filters.itemtype|default([]),
								mb: '',
							},
						)
					}}
				</td>
				<td>
					{{
						fields.dropdownArrayField(
							'filters[field]',
							'',
							fields,
							'',
							{
								no_label: true,
								full_width: true,
								multiple: true,
								values: filters.field|default([]),
								mb: '',
							},
						)
					}}
				</td>
				<td>
					{#<select name="filters[change][]" class="form-select logs-filter-select-multiple" multiple>
						<option value=""></option>
						{% set change_options = [ 'add', 'delete', 'update', 'purge', 'active', 'install', 'impersonate', 'log in', 'failed'] %}
						{% for change in change_options %}
						<option value="{{ change }}" {{ change in filters.change ? 'selected' : '' }}>
							{{ change|capitalize }}
						</option>
						{% endfor %}
					</select>#}
				</td>
				<td></td>
			</tr>
		</thead>
		<tbody>
			{% if combined is empty %}
				<tr>
					<td colspan="6" class="text-center text-muted">{{ __('No results') }}</td>
				</tr>
			{% else %}
				{% for row in combined %}
						<tr>
							<td>{{ row.id|default('') }}</td>
							<td>{{ row.date }}</td>
							<td>
								{% if row.item_url is defined %}
									<a href="{{ row.item_url }}" target="_blank">
										{{ itemtypes[row.itemtype]|default(row.itemtype) }}
									</a>
								{% elseif row.path is defined and row.path %}
									<a href="{{ row.path }}">{{ 'File open' }}</a>
								{% else %}
									{{ itemtypes[row.itemtype]|default(row.itemtype) }}
								{% endif %}
							</td>
							<td>{{ row.field|default('') }}</td>
							<td style="word-break: break-word;">
								{% if row.change is iterable %}
									{% for c in row.change %}
										{% if c is iterable %}
											{{ c.translation|default('')|raw }}
										{% else %}
											{{ c|raw }}
											{% if translations_map[c] is defined %}
												{{ translations_map[c][0]|capitalize }}
											{% endif %}
										{% endif %}
										{% if not loop.last %}<br>
										{% endif %}
									{% endfor %}
								{% else %}
									{{ row.change|raw }}
									{% if translations_map[row.change] is defined %}
										{{ translations_map[row.change][0]|capitalize }}
									{% endif %}
								{% endif %}
							</td>
							<td></td>
						</tr>
				{% endfor %}
			{% endif %}
		</tbody>
	</table>
</div>
{% set limitdropdown = include('components/dropdown/limit.html.twig') %}
<div class="ms-auto d-inline-flex align-items-center d-none d-md-block mb-2">
	{{ __('Show %s entries')|format(limitdropdown)|raw }}
</div>

<script type="text/javascript">
(function($) {
    $(document).ready(function() {
        const toggleFilterUI = function() {
            const $btn = $('#btn_show_filters');
            const $row = $('.filter_row');
            
            if ($row.is(':visible')) {
                $row.attr('style', 'display: none !important;');
                $btn.removeClass('btn-secondary active').addClass('btn-outline-secondary');
            } else {
                $row.attr('style', 'display: table-row !important;');
                $btn.addClass('btn-secondary active').removeClass('btn-outline-secondary');
                
                $('.logs-filter-select-multiple').select2({ width: '100%' });
            }
        };

        $(document).off('click.glpi_logs').on('click.glpi_logs', '#btn_show_filters', function(e) {
            e.preventDefault();
            e.stopPropagation();
            toggleFilterUI();
        });

        $('.logs-filter-select-multiple').select2({ width: '100%' });
    });
})(jQuery);
</script>