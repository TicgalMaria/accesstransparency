{% set version_parts = glpi_version|split('.') %}
{% set major_version = version_parts[0]|default(0) %}


<div class="table-responsive">
  <input type="hidden" name="id" value="{{ userId }}" />
{#
  <div class="input-group" style="max-width: 300px;">
    <form method="GET" action="user.form.php" id="searchForm" class="d-flex align-items-center" style="max-width: 300px;">
      <input type="hidden" name="id" value="{{ userId }}" />
      <input
        type="text"
        name="filters[keyword]"
        value="{{ filters.keyword|default('') }}"
        class="form-control"
        placeholder="{{ __('Search or filter results') }}"
      />
      <button class="btn btn-outline-secondary" type="submit">
        <i class="ti ti-search"></i>
        <span>{{ __('Search') }}</span>
      </button>
    </form>
  </div>

  {{ include('components/pager.html.twig', {
    href: href,
    additional_params: additional_params,
    start: start,
    count: total_number,
    is_tab: is_tab
  }) }}
#}
  <table class="table table-hover">
    <thead>
      <tr>
        <th>{{ __('ID') }}</th>
        <th>{{ __('Date') }}</th>
        <th>{{ __('User') }}</th>
        <th>ID {{ __('User') }}</th>
        <th>{{ __('Itemtype') }}</th>
        <th>{{ __('Field') }}</th>
        <th>{{ __('Changes') }}</th>
        <th>
          <span class="float-end log-toolbar mb-0">
            <button
              type="button"
              class="btn btn-sm show_log_filters {{ filters|length > 0 ? 'btn-secondary active' : 'btn-outline-secondary' }}"
            >
              <i class="ti ti-filter"></i>
              <span class="d-none d-xl-block">{{ __('Filter') }}</span>
            </button>
            <a
              href="{{ '/plugins/accesstransparency/front/export_user_csv.php?id=' ~ userId ~ '&' ~ additional_params }}"
              class="btn btn-sm btn-outline-secondary"
              target="_blank"
            >
              <i class="fas fa-file-export"></i>
              <span class="d-none d-xl-block" style="text-transform:none;">{{ __('Export') }}</span>
            </a>
          </span>
        </th>
      </tr>

      <tr class="filter_row {{ filters|length > 0 ? '' : 'd-none' }}">
        <td></td>
        <td>
          <input type="date" name="filters[fecha]" value="{{ filters.fecha|default('') }}" class="form-control" />
        </td>
        <td></td>
        <td></td>
        <td>
          <select name="filters[itemtype][]" class="form-select logs-filter-select-multiple" multiple>
            <option value=""></option>
            <option
              value="__interaction__"
              {{ '__interaction__' in filters.itemtype ? 'selected' : '' }}
            >File open</option>
            {% for key, label in itemtypes %}
              <option value="{{ key }}" {{ key in filters.itemtype ? 'selected' : '' }}>{{ label }}</option>
            {% endfor %}
          </select>
        </td>

        <td>
          <select name="filters[field][]" class="form-select logs-filter-select-multiple" multiple>
            <option value=""></option>
            {% for field in fields %}
              <option value="{{ field }}" {{ field in filters.field ? 'selected' : '' }}>{{ field }}</option>
            {% endfor %}
          </select>
        </td>

        <td>
          <select name="filters[change][]" class="form-select logs-filter-select-multiple" multiple>
            <option value=""></option>
            {% set change_options = ['add', 'delete', 'update', 'purge', 'active', 'impersonate', 'install', 'log in'] %}
            {% for change in change_options %}
              <option value="{{ change }}" {{ change in filters.change ? 'selected' : '' }}>
                {{ change|capitalize }}
              </option>
            {% endfor %}
          </select>
        </td>
        <td></td>
      </tr>
    </thead>
    <tbody>
      {% if combined is empty %}
        <tr>
          <td colspan="8" class="text-center text-muted">{{ __('No results') }}</td>
        </tr>
      {% else %}
        {% for row in combined %}
          {% if row.source == 'log' %}
            <tr>
              <td>{{ row.id|default('') }}</td>
              <td>{{ row.fecha is defined ? row.fecha|date('Y-m-d H:i') : '' }}</td>
              <td>{{ friendlyName }}</td>
              <td>{{ userId }}</td>
              <td>
                {% if row.item_url is defined %}
                  <a href="{{ row.item_url }}" target="_blank">
                    {{ itemtypes[row.itemtype]|default(row.itemtype) }}
                  </a>
                {% else %}
                  {{ itemtypes[row.itemtype]|default(row.itemtype) }}
                {% endif %}
              </td>
              <td>{{ row.field|default('') }}</td>
              <td style="word-break: break-word;">
                {% if row.change is iterable %}
                  {% for c in row.change %}
                    {% if c is iterable %}
                      {{ c.translation|default('')|raw }}
                    {% else %}
                      {{ c|raw }}
                      {% if translations_map[c] is defined %}
                        {{ translations_map[c][0]|capitalize }}
                      {% endif %}
                    {% endif %}
                    {% if not loop.last %}<br>{% endif %}
                  {% endfor %}
                {% else %}
                  {{ row.change|raw }}
                  {% if translations_map[row.change] is defined %}
                    {{ translations_map[row.change][0]|capitalize }}
                  {% endif %}
                {% endif %}
              </td>
              <td></td>
            </tr>

          {% elseif row.source == 'interaction' %}
            <tr>
              <td>{{ row.id_doc|default('') }}</td>
              <td>{{ row.fecha is defined ? row.fecha|date('Y-m-d H:i') : '' }}</td>
              <td>{{ friendlyName }}</td>
              <td>{{ userId }}</td>
              <td>
                {% if row.path is defined and row.path %}
                  <a href="{{ row.path }}">{{ 'File open' }}</a>
                {% else %}
                  File open
                {% endif %}
              </td>
              <td></td>
              <td style="word-break: break-word;">{{ __('Document') }}: {{ row.name|default('') }}</td>
              <td></td>
            </tr>

          {% elseif row.source == 'events' %}
            <tr>
              <td>{{ row.id|default('') }}</td>
              <td>{{ row.fecha is defined ? row.fecha|date('Y-m-d H:i') : '' }}</td>
              <td>{{ friendlyName }}</td>
              <td>{{ userId }}</td>
              <td>{{ row.type }}</td>
              <td>{{ row.service|default('') }}</td>
              <td style="word-break: break-word;">
                {% if row.message is defined %}
                  {% if row.message is iterable %}
                    {{ row.message.translation|default('')|raw }}
                  {% else %}
                    {{ translations_map[row.message]|default('')|raw }}
                  {% endif %}
                {% elseif row.change is defined %}
                  {% if row.change is iterable %}
                    {% for c in row.change %}
                      {% if c is iterable %}
                        {{ c.translation|default('')|raw }}
                      {% else %}
                        {{ c|raw }}
                        {% if translations_map[c] is defined %}
                          {{ translations_map[c][0]|capitalize }}
                        {% endif %}
                      {% endif %}
                      {% if not loop.last %}<br>{% endif %}
                    {% endfor %}
                  {% else %}
                    {{ row.change|raw }}
                    {% if translations_map[row.change] is defined %}
                      {{ translations_map[row.change][0]|capitalize }}
                    {% endif %}
                  {% endif %}
                {% endif %}
              </td>
              <td></td>
            </tr>
          {% endif %}
        {% endfor %}
      {% endif %}
    </tbody>
  </table>

  <div class="ms-auto d-inline-flex align-items-center d-none d-md-block mb-2 my-2">
    {{ __('Entries to show:') }}
    {% include 'components/dropdown/limit.html.twig' %}
  </div>
</div>


<script type="text/javascript">
  $(function () {
    $('.logs-filter-select-multiple').select2({ width: '100%' });
  });

  $('.show_log_filters').on('click', function (e) {
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    $('.filter_row').toggleClass('d-none');
    $(this).toggleClass('btn-secondary active btn-outline-secondary');

    return false;
  });
</script>
