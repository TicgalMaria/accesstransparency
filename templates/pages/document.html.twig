{% set version_parts = glpi_version|split('.') %}
{% set major_version = version_parts[0]|default(0) %}

<div class="table-responsive">
  <table class="table table-hover">
    <thead>
      <tr>
        <th>ID {{ __('User') }}</th>
        <th>{{ __('User') }}</th>
        <th>{{ __('Date') }}</th>
      </tr>
    </thead>
    <tbody>
      {% if combined is empty %}
        <tr>
          <td colspan="8" class="text-center text-muted">{{ __('No results') }}</td>
        </tr>
      {% else %}
        {% for row in combined %}
            <tr>
              <td>{{ row.users_id }}</td>
              <td>
                {% if row.name is iterable %}
                    {% for name in row.name %}
                        {{ name }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                {% else %}
                    {{ row.name }}
                {% endif %}
              <td>{{ row.date_creation is defined ? row.date_creation|date('Y-m-d H:i') : '' }}</td>
            </tr>
        {% endfor %}
      {% endif %}
    </tbody>
  </table>

  <div class="ms-auto d-inline-flex align-items-center d-none d-md-block mb-2 my-2">
    {{ __('Entries to show:') }}
    {% include 'components/dropdown/limit.html.twig' %}
  </div>
</div>

<script type="text/javascript">
  $(function () {
    $('.logs-filter-select-multiple').select2({ width: '100%' });
  });

  $('.show_log_filters').on('click', function (e) {
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    $('.filter_row').toggleClass('d-none');
    $(this).toggleClass('btn-secondary active btn-outline-secondary');

    return false;
  });
</script>
